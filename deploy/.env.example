IMAGE_NAMESPACE=ghcr.io/groom-team2-project/groom-semi-project-team2-mvp
IMAGE_TAG=latest
BACKEND_PORT=8080
FRONTEND_PORT=80

MYSQL_DATABASE=buying_mvp
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
MYSQL_USERNAME=soldout
MYSQL_PASSWORD=replace-with-a-different-strong-password

REDIS_LOCK_WATCHDOG_TIMEOUT_MS=30000

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=7200
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600

KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_REDIRECT_URI=https://example.com/oauth/kakao/callback
OAUTH_COOKIE_SECURE=true

TOSS_SECRET_KEY=replace-with-toss-secret-key

MAIL_USERNAME=replace-with-mail-account
MAIL_PASSWORD=replace-with-mail-app-password

AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_REGION=us-west-2
